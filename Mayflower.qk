#MAYFLOWER - A QUARK 4.0 GAME
#Download The Required Audio Files(The Only Audio Files Uploaded On This Repository) And Run The Quark Interpreter 4.0 In Terminal And Type
# 'game Mayflower'

fn tutorial
print This Is A Text Based Game.
wait 2
print Read The Story Carefully And Make Choices That Alter It
wait 3
print Only Input What Is Stated
wait 2
print Good Luck Surviving!
wait 1
fn end

wait 1
clear  #os clear
input Do You Want A Tutorial On How To Play This Game?(Y/N): -> choice
if choice == Y then call tutorial
clear
wait 1
#functions

fn endl
print =============================
print           MISERY
print =============================
wait 3
print THE END
wait 2
print Thanks For Playing!
wait 2
print Made With Quark 4.0
wait 4
kill
fn end

